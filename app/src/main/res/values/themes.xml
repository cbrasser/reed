<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Reed" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:colorControlActivated">@color/ink</item>
        <item name="android:textColorHighlight">#598E9298</item>
    </style>

    <!-- The reader's theme follows the reading setting, not the system, so selection handles
         take a graphite mid-tone that reads on Paper, Night and Black alike. -->
    <style name="Theme.Reed.Reader" parent="Theme.Reed">
        <item name="android:colorAccent">@color/graphite_mid</item>
        <item name="android:colorControlActivated">@color/graphite_mid</item>
    </style>
</resources>
